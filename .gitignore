node_modules/
.env
.env.*
*.log
*.tmp
automation/evidence/*.md
evidence/*.md
# Runtime state: client enquiries, proposals and approval decisions.
# The *.md rules above missed the .json artifacts entirely (audit S-7).
.approval/
.jobs/
evidence/
automation/evidence/
# Coding-agent output: model-generated code written under WORKSPACE_ROOT.
# Never runtime state that belongs in git, and never reviewed before it
# lands on disk.
workspace/
# Detached enquiry-runner output (client enquiry text).
logs/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
openclaw.sqlite
openclaw-agent.sqlite
*.sqlite
*.sqlite-shm
*.sqlite-wal
__pycache__/
*.pyc
.openclaw/

# Per-agent virtualenv holding the MCP SDK. Rebuilt by:
#   python -m venv agents/.venv && agents/.venv/Scripts/pip install -r requirements.txt
agents/.venv/

# Per-agent secrets. Each agent reads ONLY its own file; see agents/_common/env.py.
# The bare `.env` rule above already matches these at any depth -- named here so
# that the rule is visible to anyone adding a fourth agent.
agents/*/.env

# The Pi coding agent, installed locally by the coding agent's vendor/package.json.
# 144 packages of third-party JS; reinstall with:
#   cd agents/coding/vendor && npm install
agents/coding/vendor/node_modules/
agents/coding/vendor/package-lock.json
agents/coding/vendor/.env-mask-empty
agents/docs/output/
